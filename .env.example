# 이 프로젝트를 복사해서 새 이벤트 랜딩페이지로 쓸 때 Vercel 프로젝트의
# Settings > Environment Variables 에 아래 값들을 등록하세요.
# (이 파일 자체에는 실제 값을 적지 마세요 — 예시/설명용입니다.)

# 자신의 구글 시트에 연결된 Apps Script 웹앱 배포 주소 (.../exec 로 끝남)
APPS_SCRIPT_URL=

# Vercel Storage에서 "Upstash for Redis" 통합 추가 시 Custom Prefix를
# UPSTASH_REDIS 로 설정하면 아래 두 변수가 자동 생성됩니다 (IP 5분 제한 기능에 필요, 없어도 폼은 동작함)
UPSTASH_REDIS_KV_REST_API_URL=
UPSTASH_REDIS_KV_REST_API_TOKEN=
